{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "What the settings window's frontend may call: reading and changing settings, nothing of the pill's.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-read-crest-build-description",
    "allow-read-launch-at-login-setting",
    "allow-change-launch-at-login-setting",
    "allow-list-pill-display-options",
    "allow-choose-pill-display",
    "allow-list-allowed-player-options",
    "allow-change-allowed-players",
    "allow-change-show-every-player",
    "allow-read-claude-code-integration-setting",
    "allow-change-claude-code-integration-setting"
  ]
}
